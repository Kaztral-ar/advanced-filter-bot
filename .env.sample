# Copy this file to `.env` for local development (Render/Heroku: set these
# as dashboard/CLI environment variables instead -- .env is not used there).

# --- Required ---
TG_BOT_TOKEN=          # from @BotFather
API_ID=                # from https://my.telegram.org
API_HASH=               # from https://my.telegram.org
DATABASE_URI=            # mongodb+srv://user:pass@cluster.mongodb.net

# --- Recommended ---
DATABASE_NAME=FilterBot
AUTH_USERS=              # space/comma separated Telegram user IDs
OWNER_ID=                # your Telegram user ID

# --- Optional behaviour ---
SAVE_USER=no              # yes/no -- store user profiles (needed for /broadcast, /info by id)
MAX_FILTERS_PER_CHAT=0    # 0 = unlimited
FILTER_COOLDOWN_SECONDS=2

# --- Optional integrations ---
HEROKU_API_KEY=
LOG_CHANNEL=0

# --- Web server (Render/Heroku web dynos require a bound port) ---
ENABLE_WEB_SERVER=yes
PORT=8080

# --- Command aliases (rarely need changing) ---
ADD_FILTER_CMD=add
DELETE_FILTER_CMD=del
DELETE_ALL_CMD=delall
CONNECT_COMMAND=connect
DISCONNECT_COMMAND=disconnect
